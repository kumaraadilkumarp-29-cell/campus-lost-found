# ---------------------------------------------------------------------------
# Campus Lost & Found Portal - environment file
# Copy this file to ".env" and fill in your own values.
# ---------------------------------------------------------------------------

# Local MongoDB:  mongodb://127.0.0.1:27017/campus_lost_found
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campus_lost_found
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_found

# Any long random string. Never commit the real value.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development

# Comma separated list of browser origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5000
